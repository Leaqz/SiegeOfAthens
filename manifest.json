{
  "manifest_version": 3,
  "name": "Site Blocker",
  "version": "1.1.0",
  "description": "Block distracting websites. Manage your list in the extension settings.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Site Blocker",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}